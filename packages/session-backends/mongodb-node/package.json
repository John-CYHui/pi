{
  "name": "@earendil-works/pi-session-backend-mongodb-node",
  "version": "0.84.2",
  "description": "MongoDB session backend for Pi Coding Agent",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "clean": "node -e \"import('node:fs/promises').then(fs=>fs.rm('dist',{recursive:true,force:true}))\"",
    "build": "tsgo -p tsconfig.build.json",
    "test": "vitest --run",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "author": "Earendil Works",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/John-CYHui/pi.git",
    "directory": "packages/session-backends/mongodb-node"
  },
  "engines": { "node": ">=22.19.0" },
  "dependencies": {
    "mongodb": "7.5.0"
  },
  "devDependencies": {
    "vitest": "4.1.9"
  }
}
